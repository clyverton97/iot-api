# Copie para .env (local) ou cadastre cada variável no Render (Environment).
# Valores do Railway: MySQL > Connect > Public Network
DB_HOST=containers-us-west-000.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-isto
DB_NAME=railway
DB_SSL=false

# Chave que a Netlify Function envia no header x-api-key (deixe vazio para não exigir)
API_KEY=uma-chave-secreta-qualquer

# Site do Netlify autorizado a ler (vazio = qualquer origem)
CORS_ORIGIN=https://seu-site.netlify.app

# PORT é definida pelo Render sozinho; local usa 3000
PORT=3000
